<?php

declare(strict_types=1);

use Hyva\CmsLiveviewEditor\ViewModel\Icons;
use Hyva\Theme\Model\ViewModelRegistry;
use Magento\Backend\Block\Template;
use Magento\Framework\Escaper;

/** @var Template $block */
/** @var Escaper $escaper */
/** @var ViewModelRegistry $viewModels */

/** @var Icons $icons */
$icons = $viewModels->require(Icons::class);

$uploadUrl  = $escaper->escapeUrl($block->getUrl('blackbird_hyvacmslibrary/fileUpload/upload'));
$listingUrl = $escaper->escapeUrl($block->getUrl('blackbird_hyvacmslibrary/fileUpload/listing'));
?>
<dialog x-data="initFileSelect()"
        @toggle-file-select.window="initializeModal($event.detail)"
        @keydown.window.escape="open = false"
        class="w-screen max-h-screen h-screen me-0 open:flex flex-col p-0"
        x-show="open"
        x-htmldialog.noscroll="open = false"
        x-transition:enter="transition ease-in-out duration-500 sm:duration-700"
        x-transition:enter-start="translate-x-full"
        x-transition:enter-end="translate-x-0"
        x-transition:leave="transition ease-in-out duration-500 sm:duration-700"
        x-transition:leave-start="translate-x-0"
        x-transition:leave-end="translate-x-full"
        x-cloak>

    <div class="bg-nimbus-950 py-2.5 px-6 flex items-center justify-between text-nimbus-50">
        <p class="flex items-center gap-2">
            <span class="flex items-center justify-center size-8 rounded-md border border-nimbus-700 text-meadow-500">
                <?= /** @noEscape */ $icons->fileHtml('', 20, 20, ['aria-hidden' => 'true']) ?>
            </span>
            <strong><?= $escaper->escapeHtml(__('File Select')) ?></strong>
        </p>
        <div class="flex items-center gap-2">
            <label class="btn btn-primary flex items-center gap-2 cursor-pointer"
                   :class="uploading ? 'opacity-50 pointer-events-none' : ''">
                <?= /** @noEscape */ $icons->uploadHtml('', 16, 16, ['aria-hidden' => 'true']) ?>
                <span x-text="uploading
                    ? '<?= $escaper->escapeJs(__('Uploading...')->render()) ?>'
                    : '<?= $escaper->escapeJs(__('Upload File')->render()) ?>'">
                </span>
                <input type="file"
                       class="sr-only"
                       :accept="acceptAttr"
                       @change="uploadFile($event)"
                       :disabled="uploading">
            </label>
            <button type="button"
                    class="rounded-md transition-colors duration-200 flex items-center justify-center size-11
                           hover:bg-nimbus-900 text-nimbus-200"
                    aria-label="<?= $escaper->escapeHtml(__('Close')) ?>"
                    @click="open = false">
                <?= /** @noEscape */ $icons->panelRightCloseHtml('', 24, 24, ['aria-hidden' => 'true']) ?>
            </button>
        </div>
    </div>

    <template x-if="error">
        <p class="bg-red-100 text-red-700 text-sm px-6 py-2" x-text="error"></p>
    </template>

    <div class="grid grid-cols-[1fr_260px] gap-4 h-full overflow-hidden">
        <div class="overflow-y-auto p-4">
            <template x-if="files.length === 0 && !loadingFiles">
                <p class="text-nimbus-400 text-sm text-center mt-8">
                    <?= $escaper->escapeHtml(__('No files found. Upload one to get started.')) ?>
                </p>
            </template>
            <div class="grid grid-cols-4 gap-3">
                <template x-for="(file, index) in files" :key="file.url">
                    <button type="button"
                            @click="selectFile(file)"
                            :class="selectedFile?.url === file.url
                                ? 'ring-2 ring-meadow-500'
                                : 'ring-1 ring-nimbus-200'"
                            class="rounded-lg overflow-hidden flex flex-col items-center p-2 gap-2
                                   hover:ring-2 hover:ring-meadow-400 transition-all bg-white">
                        <template x-if="file.poster_url">
                            <img :src="file.poster_url" class="w-full h-20 object-cover rounded" loading="lazy">
                        </template>
                        <template x-if="!file.poster_url">
                            <span class="flex items-center justify-center w-full h-20 bg-nimbus-100 rounded text-nimbus-400 text-xs uppercase font-bold"
                                  x-text="file.extension">
                            </span>
                        </template>
                        <span class="text-xs text-nimbus-600 truncate w-full text-center"
                              x-text="file.filename">
                        </span>
                    </button>
                </template>
            </div>
        </div>

        <div class="flex flex-col gap-4 p-4 border-l border-nimbus-200 overflow-y-auto">
            <template x-if="selectedFile">
                <div class="flex flex-col gap-4">
                    <template x-if="selectedFile.poster_url">
                        <img :src="selectedFile.poster_url" class="w-full object-cover rounded-md">
                    </template>
                    <template x-if="!selectedFile.poster_url">
                        <span class="flex items-center justify-center w-full h-24 bg-nimbus-100 rounded-md
                                     text-nimbus-400 text-lg uppercase font-bold"
                              x-text="selectedFile.extension">
                        </span>
                    </template>

                    <p class="text-sm text-nimbus-700 break-all" x-text="selectedFile.filename"></p>

                    <button type="button"
                            @click="saveFile()"
                            class="btn btn-primary justify-center">
                        <?= $escaper->escapeHtml(__('Save')) ?>
                    </button>
                </div>
            </template>
            <template x-if="!selectedFile">
                <p class="text-nimbus-400 text-sm text-center mt-8">
                    <?= $escaper->escapeHtml(__('Select a file to continue.')) ?>
                </p>
            </template>
        </div>
    </div>
</dialog>

<script>
function initFileSelect() {
    return {
        open: false,
        uid: null,
        fieldName: null,
        authorizedExtensions: '',
        acceptAttr: '*',
        files: [],
        loadingFiles: false,
        uploading: false,
        uploadingPoster: false,
        error: null,
        selectedFile: null,

        getFormKey() {
            return document.querySelector('input[name="form_key"]')?.value
                || window.FORM_KEY
                || '';
        },

        async initializeModal({ isOpen, uid, fieldName, fieldValue, authorizedExtensions } = {}) {
            const parsed = typeof fieldValue === 'string' ? JSON.parse(fieldValue) : fieldValue;

            Object.assign(this, {
                open: isOpen,
                uid,
                fieldName,
                authorizedExtensions,
                acceptAttr: authorizedExtensions
                    ? authorizedExtensions.split(',').map(e => '.' + e.trim()).join(',')
                    : '*',
                selectedFile: parsed?.url ? parsed : null,
                error: null,
            });

            await this.loadFiles();
        },

        async loadFiles() {
            this.loadingFiles = true;
            try {
                const url = new URL('<?= $escaper->escapeJs($listingUrl) ?>');
                url.searchParams.set('extensions', this.authorizedExtensions);
                const response = await fetch(url.toString());
                const data = await response.json();
                this.files = data.files || [];
            } catch {
                this.files = [];
            } finally {
                this.loadingFiles = false;
            }
        },

        async uploadFile(event) {
            const file = event.target.files[0];
            if (!file) return;

            this.uploading = true;
            this.error = null;

            try {
                const formData = new FormData();
                formData.append('file', file);
                formData.append('authorized_extensions', this.authorizedExtensions);
                formData.append('form_key', this.getFormKey());

                const response = await fetch('<?= $escaper->escapeJs($uploadUrl) ?>', {
                    method: 'POST',
                    body: formData,
                });

                const data = await response.json();
                if (data.error) throw new Error(data.error);

                this.files.unshift(data);
                this.selectedFile = data;
            } catch (e) {
                this.error = e.message;
            } finally {
                this.uploading = false;
                event.target.value = '';
            }
        },

        async uploadPoster(event) {
            const file = event.target.files[0];
            if (!file || !this.selectedFile) return;

            this.uploadingPoster = true;
            this.error = null;

            try {
                const formData = new FormData();
                formData.append('poster', file);
                formData.append('type', 'poster');
                formData.append('video_filename', this.selectedFile?.filename ?? '');
                formData.append('form_key', this.getFormKey());

                const response = await fetch('<?= $escaper->escapeJs($uploadUrl) ?>', {
                    method: 'POST',
                    body: formData,
                });

                const data = await response.json();
                if (data.error) throw new Error(data.error);

                this.selectedFile = { ...this.selectedFile, poster_url: data.poster_url };

                const idx = this.files.findIndex(f => f.url === this.selectedFile.url);
                if (idx !== -1) {
                    this.files.splice(idx, 1, { ...this.files[idx], poster_url: data.poster_url });
                }
            } catch (e) {
                this.error = e.message;
            } finally {
                this.uploadingPoster = false;
                event.target.value = '';
            }
        },

        selectFile(file) {
            this.selectedFile = file;
            this.error = null;
        },

        saveFile() {
            if (!this.selectedFile) return;

            this.$dispatch('editor-change', {
                name: this.uid,
                field: this.fieldName,
                value: this.selectedFile,
                saveState: true,
            });

            this.open = false;
        },
    };
}
</script>
