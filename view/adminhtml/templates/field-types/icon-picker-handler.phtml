<?php

declare(strict_types=1);

use Hyva\CmsLiveviewEditor\ViewModel\Icons;
use Hyva\Theme\Model\ViewModelRegistry;
use Hyva\Theme\ViewModel\HyvaCsp;
use Magento\Backend\Block\Template;
use Magento\Framework\Escaper;

/** @var Template $block */
/** @var Escaper $escaper */
/** @var ViewModelRegistry $viewModels */
/** @var HyvaCsp $hyvaCsp */

/** @var Icons $icons */
$icons = $viewModels->require(Icons::class);

$listingUrl = $block->getUrl('blackbird_hyvacmslibrary/icon/listing');
?>
<dialog x-data="initIconSelect()"
        @toggle-icon-select.window="initializeModal($event.detail)"
        @keydown.window.escape="open = false"
        class="w-screen max-w-161.5 p-0 shadow-xl rounded-lg open:flex flex-col max-h-screen-80"
        x-show="open"
        x-htmldialog.noscroll="open = false"
        x-transition
        x-cloak>

    <div class="shrink-0 flex items-center gap-4 py-4 px-6 border-b border-nimbus-200 bg-nimbus-50">
        <span class="size-8 border border-nimbus-300 rounded-md flex items-center justify-center text-meadow-700">
            <?= /** @noEscape */ $icons->renderHtml('shapes', '', 20, 20, ['aria-hidden' => 'true']) ?>
        </span>
        <strong><?= $escaper->escapeHtml(__('Select an Icon')) ?></strong>
    </div>

    <div class="shrink-0 px-6 py-4 border-b border-nimbus-100">
        <label class="relative block">
            <span class="sr-only"><?= $escaper->escapeHtml(__('Search icons')) ?></span>
            <span class="absolute left-3 top-1/2 -translate-y-1/2 text-nimbus-500 pointer-events-none">
                <?= /** @noEscape */ $icons->renderHtml('search', '', 18, 18, ['aria-hidden' => 'true']) ?>
            </span>
            <input type="search"
                   x-ref="searchInput"
                   class="form-input w-full pl-10"
                   placeholder="<?= $escaper->escapeHtmlAttr(__('Search icons…')) ?>"
                   @input.debounce.200ms="search = $event.target.value; resetVisibleCount(); $nextTick(() => observeSentinel())">
        </label>
    </div>

    <div class="grow overflow-y-auto px-6 py-4 space-y-6" x-ref="scrollArea">
        <template x-if="loading">
            <div class="flex items-center justify-center gap-2 py-12 text-nimbus-500">
                <?= /** @noEscape */ $icons->renderHtml('loader-circle', 'animate-spin', 20, 20, ['aria-hidden' => 'true']) ?>
                <span><?= $escaper->escapeHtml(__('Loading icons…')) ?></span>
            </div>
        </template>

        <template x-if="error">
            <p class="py-12 text-center text-red-600" x-text="error"></p>
        </template>

        <template x-for="section in visibleSections" :key="section.group">
            <section>
                <div class="flex items-baseline justify-between mb-3">
                    <h3 class="text-sm font-semibold uppercase tracking-wide text-nimbus-700" x-text="section.title"></h3>
                    <span class="text-xs text-nimbus-500" x-text="section.total"></span>
                </div>
                <div class="grid grid-cols-5 gap-2">
                    <template x-for="icon in section.icons" :key="icon.value">
                        <button type="button"
                                @click="selectIcon(icon)"
                                :title="icon.value"
                                :class="selected?.value === icon.value
                                    ? 'border-meadow-700 bg-meadow-50 text-meadow-800'
                                    : 'border-transparent hover:bg-nimbus-100'"
                                class="flex flex-col items-center gap-1.5 p-2 rounded-lg border-2 transition-colors cursor-pointer">
                            <span class="size-6 flex items-center justify-center" x-html="icon.svg"></span>
                            <span class="text-xs leading-tight text-center break-all line-clamp-2"
                                  x-text="icon.name"></span>
